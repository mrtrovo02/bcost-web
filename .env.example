NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
INTERNAL_API_URL=http://127.0.0.1:5000
NEXT_PUBLIC_ENABLE_DEMO=false

# Mantem fallbacks demonstrativos apenas para desenvolvimento/homologacao controlada.
# Em producao de clientes reais, deixe false.
# Quando a demo publica estiver habilitada, o frontend enviara token demo e x-demo-session=true.
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false
