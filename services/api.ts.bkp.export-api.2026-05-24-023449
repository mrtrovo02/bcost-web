/**
 * Cookies e Storage
 *
 * Segurança:
 * - JWT e refresh token NÃO são persistidos em localStorage.
 * - Tokens legados em localStorage são migrados para cookie e removidos.
 * - Cookies client-side usam Secure em HTTPS e SameSite=Lax.
 * - HttpOnly não pode ser definido via document.cookie.
 */

const USER_STORAGE_ALLOWED_KEYS = new Set([
  'id',
  'email',
  'name',
  'companyId',
  'role',
  'active',
  'twoFactor',
  'company',
]);

function readCookie(name: string): string | null {
  if (!isBrowser()) return null;

  const cookies = document.cookie ? document.cookie.split(';') : [];

  for (const cookie of cookies) {
    const [rawKey, ...rawValue] = cookie.trim().split('=');
    const key = rawKey?.trim();
    const value = rawValue.join('=');

    if (key === name && value) {
      try {
        return decodeURIComponent(value);
      } catch {
        return value;
      }
    }
  }

  return null;
}

function cookieDomainSuffix(): string {
  if (!isBrowser()) return '';

  const hostname = window.location.hostname;

  if (hostname === 'bcost.com.br' || hostname.endsWith('.bcost.com.br')) {
    return '; domain=.bcost.com.br';
  }

  return '';
}

function writeCookie(
  name: string,
  value: string,
  maxAgeSeconds = DEFAULT_COOKIE_MAX_AGE_SECONDS,
) {
  if (!isBrowser() || !validValue(value)) return;

  const encoded = encodeURIComponent(value);
  const secure = isProductionHost() ? '; Secure' : '';
  const domain = cookieDomainSuffix();

  document.cookie = `${name}=${encoded}; path=/; max-age=${maxAgeSeconds}; SameSite=Lax${secure}`;

  if (domain) {
    document.cookie = `${name}=${encoded}; path=/; max-age=${maxAgeSeconds}; SameSite=Lax${secure}${domain}`;
  }
}

function deleteCookie(name: string) {
  if (!isBrowser()) return;

  const secure = isProductionHost() ? '; Secure' : '';
  const domain = cookieDomainSuffix();

  document.cookie = `${name}=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax${secure}`;

  if (domain) {
    document.cookie = `${name}=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax${secure}${domain}`;
  }
}

function getStorageItem(keys: string[]): string | null {
  if (!isBrowser()) return null;

  for (const key of keys) {
    const value = window.localStorage.getItem(key);
    if (validValue(value)) return value;
  }

  return null;
}

function setStorageItems(keys: string[], value: string) {
  if (!isBrowser() || !validValue(value)) return;

  for (const key of keys) {
    window.localStorage.setItem(key, value);
  }
}

function removeStorageItems(keys: string[]) {
  if (!isBrowser()) return;

  for (const key of keys) {
    window.localStorage.removeItem(key);
  }
}

function sanitizeStoredUser(user: BcostUser): BcostUser {
  const sanitized: BcostUser = {
    id: user.id,
    email: user.email,
  };

  for (const [key, value] of Object.entries(user)) {
    const normalizedKey = key.toLowerCase();

    if (!USER_STORAGE_ALLOWED_KEYS.has(key)) continue;

    if (
      normalizedKey.includes('token') ||
      normalizedKey.includes('password') ||
      normalizedKey.includes('secret') ||
      normalizedKey.includes('cookie')
    ) {
      continue;
    }

    sanitized[key] = value;
  }

  return sanitized;
}

/**
 * Token/session API
 */

export function getToken(): string | null {
  if (!isBrowser()) return null;

  for (const key of TOKEN_KEYS) {
    const cookieValue = readCookie(key);
    if (validValue(cookieValue)) return cookieValue;
  }

  const legacyToken = getStorageItem(TOKEN_KEYS);

  if (validValue(legacyToken)) {
    writeCookie('bcost_token', legacyToken);
    writeCookie('bcost_access_token', legacyToken);
    removeStorageItems(TOKEN_KEYS);
    return legacyToken;
  }

  return null;
}

export function getStoredToken(): string | null {
  return getToken();
}

export function setStoredToken(token: string) {
  if (!isBrowser() || !validValue(token)) return;

  removeStorageItems(TOKEN_KEYS);
  writeCookie('bcost_token', token);
  writeCookie('bcost_access_token', token);
}

export function clearStoredToken() {
  if (!isBrowser()) return;

  removeStorageItems(TOKEN_KEYS);

  for (const key of TOKEN_KEYS) {
    deleteCookie(key);
  }
}

export function getRefreshToken(): string | null {
  if (!isBrowser()) return null;

  for (const key of REFRESH_TOKEN_KEYS) {
    const cookieValue = readCookie(key);
    if (validValue(cookieValue)) return cookieValue;
  }

  const legacyRefreshToken = getStorageItem(REFRESH_TOKEN_KEYS);

  if (validValue(legacyRefreshToken)) {
    writeCookie('bcost_refresh_token', legacyRefreshToken);
    removeStorageItems(REFRESH_TOKEN_KEYS);
    return legacyRefreshToken;
  }

  return null;
}

export function setRefreshToken(token?: string | null) {
  if (!isBrowser() || !validValue(token)) return;

  removeStorageItems(REFRESH_TOKEN_KEYS);
  writeCookie('bcost_refresh_token', token);
}

export function clearRefreshToken() {
  if (!isBrowser()) return;

  removeStorageItems(REFRESH_TOKEN_KEYS);

  for (const key of REFRESH_TOKEN_KEYS) {
    deleteCookie(key);
  }
}

export function getActiveCompanyId(): string | null {
  return getStorageItem(COMPANY_KEYS);
}

export function setActiveCompanyId(companyId: string) {
  if (!validValue(companyId)) return;

  setStorageItems(COMPANY_KEYS, companyId);
}

export function clearActiveCompanyId() {
  removeStorageItems(COMPANY_KEYS);
}

export function getStoredUser(): BcostUser | null {
  if (!isBrowser()) return null;

  for (const key of USER_KEYS) {
    const value = window.localStorage.getItem(key);

    if (!validValue(value)) continue;

    try {
      return JSON.parse(value) as BcostUser;
    } catch {
      window.localStorage.removeItem(key);
    }
  }

  return null;
}

export function setStoredUser(user?: BcostUser | null) {
  if (!isBrowser() || !user) return;

  const safeUser = sanitizeStoredUser(user);
  const serialized = JSON.stringify(safeUser);

  for (const key of USER_KEYS) {
    window.localStorage.setItem(key, serialized);
  }

  const companyId =
    safeUser.companyId ||
    (safeUser.company && typeof safeUser.company === 'object'
      ? (safeUser.company as Record<string, unknown>).id
      : undefined);

  if (typeof companyId === 'string') {
    setActiveCompanyId(companyId);
  }
}

export function clearStoredUser() {
  if (!isBrowser()) return;

  removeStorageItems(USER_KEYS);
}

export function hasSession(): boolean {
  return Boolean(getToken());
}

function redirectToLogin(reason = 'expired') {
  if (!isBrowser()) return;

  const path = window.location.pathname;

  if (path.startsWith('/login')) return;

  const redirect = encodeURIComponent(
    `${window.location.pathname}${window.location.search}`,
  );

  window.location.href = `/login?session=${reason}&redirect=${redirect}`;
}

function createAuthMissingError(config: InternalAxiosRequestConfig) {
  const error = new Error(
    'AUTH_MISSING: requisição protegida bloqueada no frontend antes de chegar na API.',
  );

  return Object.assign(error, {
    isAuthMissing: true,
    status: 0,
    config,
  });
}

function isAuthMissingError(error: unknown): error is {
  isAuthMissing: boolean;
  config?: AxiosRequestConfig;
  status: number;
} {
  return Boolean(
    error &&
      typeof error === 'object' &&
      (error as Record<string, unknown>).isAuthMissing === true,
  );
}

function extractToken(data: AuthResponse): string | null {
  return data?.access_token || data?.accessToken || data?.token || null;
}

function extractRefreshToken(data: AuthResponse): string | null {
  return data?.refresh_token || data?.refreshToken || null;
}

function persistAuthResponse(data: AuthResponse) {
  const token = extractToken(data);
  const refreshToken = extractRefreshToken(data);

  if (token) setStoredToken(token);
  if (refreshToken) setRefreshToken(refreshToken);

  if (data.user && typeof data.user === 'object') {
    setStoredUser(data.user);
  }

  const companyId =
    data.companyId ||
    data.user?.companyId ||
    (data.user?.company && typeof data.user.company === 'object'
      ? (data.user.company as Record<string, unknown>).id
      : undefined);

  if (typeof companyId === 'string') {
    setActiveCompanyId(companyId);
  }
}

/**
 * Interceptors
 */

api.interceptors.request.use((config: InternalAxiosRequestConfig) => {
  if (!isBrowser()) return config;

  const token = getToken();
  const companyId = getActiveCompanyId();
  const headers = AxiosHeaders.from(config.headers || {});
  const publicPath = isPublicApiPath(config.url);

  headers.set('Accept', 'application/json');

  if (!headers.has('Content-Type')) {
    headers.set('Content-Type', 'application/json');
  }

  /**
   * Proteção enterprise:
   * Se a rota é protegida e não existe token no browser, bloqueia antes de bater na API.
   * Isso reduz logs 401 falsos em /company, /dashboard/overview, /revenue/metrics etc.
   */
  if (!token && !publicPath) {
    throw createAuthMissingError(config);
  }

  if (token && !headers.has('Authorization')) {
    headers.set('Authorization', `Bearer ${token}`);
  }

  if (companyId && !headers.has('x-company-id')) {
    headers.set('x-company-id', companyId);
  }

  config.headers = headers;

  return config;
});

api.interceptors.response.use(
  (response) => response,
  (error: AxiosError<any> | any) => {
    if (isAuthMissingError(error)) {
      if (isBrowser() && window.location.pathname.startsWith('/dashboard')) {
        redirectToLogin('expired');
      }

      return Promise.reject({
        status: 0,
        message:
          'Sessão não encontrada no navegador. A chamada protegida foi bloqueada antes de chegar na API.',
        raw: error,
      } satisfies BcostApiError);
    }

    const status = error.response?.status || 0;
    const data = error.response?.data || {};
    const message =
      data?.message ||
      error.message ||
      'Erro inesperado';

    const apiError: BcostApiError = {
      status,
      message,
      path: data?.path || error.config?.url,
      requestId: data?.requestId,
      raw: error,
    };

    if (process.env.NODE_ENV !== 'production') {
      console.error('🔴 API ERROR:', {
        status: apiError.status,
        message: apiError.message,
        path: apiError.path,
        requestId: apiError.requestId,
      });
    }

    if (status === 401 && isBrowser()) {
      clearStorageSession();
      redirectToLogin('expired');
    }

    return Promise.reject(apiError);
  },
);

/**
 * Generic request helpers
 */

export async function apiGet<T = unknown>(
  path: string,
  params?: Record<string, unknown>,
  config?: AxiosRequestConfig,
): Promise<T> {
  const response = await api.get<T>(path, {
    ...config,
    params: buildQuery(params),
  });

  return response.data;
}

export async function apiPost<T = unknown>(
  path: string,
  body?: unknown,
  config?: AxiosRequestConfig,
): Promise<T> {
  const response = await api.post<T>(path, body, config);
  return response.data;
}

export async function apiPut<T = unknown>(
  path: string,
  body?: unknown,
  config?: AxiosRequestConfig,
): Promise<T> {
  const response = await api.put<T>(path, body, config);
  return response.data;
}

export async function apiPatch<T = unknown>(
  path: string,
  body?: unknown,
  config?: AxiosRequestConfig,
): Promise<T> {
  const response = await api.patch<T>(path, body, config);
  return response.data;
}

export async function apiDelete<T = unknown>(
  path: string,
  config?: AxiosRequestConfig,
): Promise<T> {
  const response = await api.delete<T>(path, config);
  return response.data;
}

/**
 * Backward-compatible session functions
 */

export function setStorageSession(token: string, user?: BcostUser | any) {
  if (!isBrowser()) return;

  setStoredToken(token);

  if (user) {
    setStoredUser(user);

    const companyId =
      user.companyId ||
      user.company?.id ||
      user.activeCompanyId ||
      user.company_id;

    if (companyId) {
      setActiveCompanyId(companyId);
    }
  }
}

export function clearStorageSession() {
  if (!isBrowser()) return;

  clearStoredToken();
  clearRefreshToken();
  clearActiveCompanyId();
  clearStoredUser();
}

/**
 * Auth
 */

export async function login(email: string, password: string) {
  const data = await apiPost<AuthResponse>('/auth/login', {
    email,
    password,
  });

  persistAuthResponse(data);

  return data;
}

export async function switchCompany(companyId: string) {
  const data = await apiPost<AuthResponse>('/auth/switch-company', {
    companyId,
  });

  persistAuthResponse(data);
  setActiveCompanyId(companyId);

  return data;
}

export async function getMe() {
  const data = await apiGet<BcostUser>('/auth/me');

  setStoredUser(data);

  if (data?.companyId) {
    setActiveCompanyId(data.companyId);
  }

  return data;
}

export const authApi = {
  login,
  switchCompany,
  me: getMe,
  logout: async () => {
    try {
      await apiPost('/auth/logout');
    } catch {
      // logout local continua mesmo se endpoint não existir
    } finally {
      clearStorageSession();
    }
  },
  clear: clearStorageSession,
  hasSession,
};

