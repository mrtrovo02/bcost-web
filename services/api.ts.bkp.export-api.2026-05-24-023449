/**
 * Resolver empresa ativa de forma robusta.
 */

export async function resolveActiveCompanyId(): Promise<string | null> {
  const active = getActiveCompanyId();

  if (active) return active;

  try {
    const me = await getMe();

    if (me?.companyId) {
      setActiveCompanyId(me.companyId);
      return me.companyId;
    }
  } catch {
    // segue para fallback
  }

  try {
    const companies = await companyApi.list();
    const first = Array.isArray(companies) ? companies[0] : null;

    if (first?.id) {
      setActiveCompanyId(first.id);
      return first.id;
    }
  } catch {
    // sem fallback
  }

  return null;
}

