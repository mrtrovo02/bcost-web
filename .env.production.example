# Template seguro para EC2/producao do app.bcost.com.br.
# Nao coloque segredos reais neste arquivo versionado.

NEXT_PUBLIC_APP_URL=https://app.bcost.com.br
NEXT_PUBLIC_API_URL=https://api.bcost.com.br/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.bcost.com.br/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.bcost.com.br

# Chamadas server-side do Next.js devem usar rede local da EC2.
INTERNAL_API_URL=http://127.0.0.1:5000

# Producao oficial com clientes reais.
NEXT_PUBLIC_ENABLE_DEMO=false
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false
NEXT_PUBLIC_DEMO_ACCESS_MODE=disabled

# Para beta pago/controlado use beta ou controlled-beta.
# Para venda oficial use official, live, enterprise ou production-live.
NEXT_PUBLIC_RELEASE_STAGE=beta
